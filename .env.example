# =====================================================================
#                CONFIGURACIÓN DE RED-DISCORDBOT (.env)
# =====================================================================
# Modifica este archivo según tus necesidades.
# Si estás usando .env.example, crea una copia llamada .env:
#   copy .env.example .env

# ---------------------------------------------------------------------
# 1. AUTENTICACIÓN Y PREFIJO (OBLIGATORIO)
# ---------------------------------------------------------------------
# Token secreto de tu bot de Discord obtenido en:
# https://discord.com/developers/applications
TOKEN=tu_token_de_discord_aqui

# Prefijo para invocar comandos del bot (ej: !, ?, r!).
# Puedes poner varios separados por espacio: PREFIX=! ? r!
PREFIX=!

# ---------------------------------------------------------------------
# 2. IDENTIFICACIÓN Y PERMISOS
# ---------------------------------------------------------------------
# Nombre de la instancia en RedBot (por defecto: RedBot)
INSTANCE_NAME=RedBot

# Tu ID numérico de usuario en Discord (obtener con Modo Desarrollador en Discord).
# Muy recomendado para tener control total de comandos de dueño ([p]load, [p]cog, etc.).
OWNER_ID=

# IDs de co-propietarios adicionales separados por espacio (opcional)
CO_OWNERS=

# Tratar a los desarrolladores/administradores del equipo de Discord como dueños (true/false)
TEAM_MEMBERS_ARE_OWNERS=false

# ---------------------------------------------------------------------
# 3. ALMACENAMIENTO Y RUTAS (CONTROL TOTAL)
# ---------------------------------------------------------------------
# Carpeta donde se guardarán los datos, cogs y configuraciones:
# - Déjalo vacío para usar la ruta por defecto del sistema (AppData en Windows)
# - O pon una ruta relativa como ./data para tener los datos dentro de este proyecto
DATA_PATH=

# Tipo de almacenamiento: JSON (por defecto, no requiere base de datos) o POSTGRES
STORAGE_TYPE=JSON

# Si usas STORAGE_TYPE=POSTGRES, rellena los siguientes datos:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=redbot

# ---------------------------------------------------------------------
# 4. OPCIONES ADICIONALES
# ---------------------------------------------------------------------
# Modo desarrollador (true/false)
DEV_MODE=false

# Nivel de registro de logs: 0=normal, 1=verbose (-v), 2=debug (-vv)
LOG_LEVEL=0
